filters:
  and:
    - file.hasTag("event")
views:
  - type: calendar
    name: Calendar
    order:
      - file.name
      - tags
      - related
      - url
    startEvent: note.date
    endEvent: note.endEvent
  - type: cards
    name: Table
    order:
      - file.name
      - date
      - endEvent
      - tags
      - related
